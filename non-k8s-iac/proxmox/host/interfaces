# Addressing on the LAN bridge keeps host management and bridged guests on the same subnet.
auto lo
iface lo inet loopback

source /etc/network/interfaces.d/*

iface eno1 inet manual

auto vmbr0
iface vmbr0 inet static
    address 192.168.1.69/24
    gateway 192.168.1.1
    bridge-ports eno1
    bridge-stp off
    bridge-fd 0
